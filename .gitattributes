# Keep source files consistent across Windows, macOS, Linux and WSL.
* text=auto eol=lf

*.java text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.txt text eol=lf

# Binary assets should never be line-ending converted.
*.epub binary
*.jar binary
*.woff2 binary
*.apk binary
*.aab binary
*.png binary
*.jks binary
*.keystore binary
